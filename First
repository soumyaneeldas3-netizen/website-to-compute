<!DOCTYPE html>
<html>
<head>
    <title>ChatGPT Web App</title>
    <style>
        body { font-family: Arial; margin: 40px; }
        #response { white-space: pre-wrap; margin-top: 20px; padding: 10px; border: 1px solid #ccc; }
    </style>
</head>
<body>

<h2>ChatGPT Prompt Sender</h2>

<textarea id="prompt" rows="5" cols="60" placeholder="Type your prompt here..."></textarea>
<br><br>

<button onclick="sendToChatGPT()">Send Prompt</button>

<h3>Response:</h3>
<div id="response"></div>

<script>
    async function sendToChatGPT() {
        const prompt = document.getElementById("prompt").value;
        const responseBox = document.getElementById("response");

        responseBox.innerHTML = "Loading...";

        try {
            const response = await fetch("https://api.openai.com/v1/chat/completions", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer YOUR_OPENAI_API_KEY"
                },
                body: JSON.stringify({
                    model: "gpt-4o-mini",
                    messages: [{ role: "user", content: prompt }]
                })
            });

            const data = await response.json();
            responseBox.innerHTML = data.choices[0].message.content;

        } catch (error) {
            responseBox.innerHTML = "Error: " + error;
        }
    }
</script>

</body>
</html>
